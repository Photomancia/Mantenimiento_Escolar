# Copia este archivo como .env.local (no se sube a Git) y ajusta los valores.
#
# ATENCIÓN: las variables VITE_* se incrustan en el JavaScript que descarga el
# navegador. NUNCA pongas aquí contraseñas, tokens ni datos de la base de datos.

# Modo de la aplicación:
#   api  -> consume el backend PHP real (predeterminado).
#   demo -> datos ficticios locales, sin backend. Se muestra un aviso visible.
VITE_APP_MODE=api

# URL base de la API (sin barra final).
#   Desarrollo con el proxy de Vite: /api
#   Producción en el mismo dominio:  /api
VITE_API_BASE_URL=/api

# Tiempo máximo de espera por petición, en milisegundos (opcional).
VITE_API_TIMEOUT_MS=15000

# Solo para el servidor de desarrollo (no llega al navegador):
# dirección del backend PHP local al que se reenvía /api.
API_PROXY_TARGET=http://localhost:8000
